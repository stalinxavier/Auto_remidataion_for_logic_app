{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_an_HTTP_request_is_received": {
      "type": "Request",
      "kind": "Http"
    }
  },
  "actions": {
    "Compose": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@{if(or(equals(triggerBody()?['value'], null), empty(replace(replace(replace(replace(trim(string(triggerBody()?['value'])), ',', ''), ' ', ''), '+', ''), '-', '')), equals(replace(replace(replace(replace(replace(replace(trim(string(triggerBody()?['value'])), ',', ''), ' ', ''), '+', ''), '-', ''), '0', ''), '.', ''), '')), 0, div(float(10), float(replace(replace(replace(replace(trim(string(triggerBody()?['value'])), ',', ''), ' ', ''), '+', ''), '-', ''))))}"
    }
  },
  "outputs": {}
}