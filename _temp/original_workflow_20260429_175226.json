{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "customerId": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "customerId",
            "email",
            "amount"
          ]
        }
      }
    }
  },
  "actions": {
    "Get_Customer_Info": {
      "runAfter": {},
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "https://api.customerservice.com/v1/customers/@{triggerBody()['customerId']}",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "Parse_Customer_Response": {
      "runAfter": {
        "Get_Customer_Info": [
          "Succeeded"
        ]
      },
      "type": "ParseJson",
      "inputs": {
        "content": "@body('Get_Customer_Info')",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "street": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "zipcode": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "Check_Customer_Status": {
      "actions": {
        "Process_Payment": {
          "runAfter": {},
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://api.paymentgateway.com/v2/process-payment",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "customerId": "@body('Parse_Customer_Response')['id']",
              "amount": "@triggerBody()['amount']",
              "currency": "USD",
              "metadata": {
                "timestamp": "@utcNow()",
                "source": "logicapp"
              }
            }
          }
        },
        "Parse_Payment_Response": {
          "runAfter": {
            "Process_Payment": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Process_Payment')",
            "schema": {
              "type": "object",
              "properties": {
                "transactionId": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "timestamp": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Send_Confirmation_Email": {
          "runAfter": {
            "Parse_Payment_Response": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://api.emailservice.com/send-email",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "to": "@triggerBody()['email']",
              "subject": "Payment Confirmation",
              "body": "Your payment of $@{triggerBody()['amount']} has been processed successfully. Transaction ID: @{body('Parse_Payment_Response')['transactionId']}"
            }
          }
        },
        "Update_Customer_Record": {
          "runAfter": {
            "Send_Confirmation_Email": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "PATCH",
            "uri": "https://api.customerservice.com/v1/customers/@{body('Parse_Customer_Response')['id']}/last-transaction",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "transactionId": "@body('Parse_Payment_Response')['transactionId']",
              "amount": "@triggerBody()['amount']",
              "timestamp": "@body('Parse_Payment_Response')['timestamp']"
            }
          }
        }
      },
      "runAfter": {
        "Parse_Customer_Response": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {
          "Send_Rejection_Email": {
            "runAfter": {},
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "https://api.emailservice.com/send-email",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "to": "@triggerBody()['email']",
                "subject": "Payment Rejected",
                "body": "Your payment request has been rejected. Account status: @{body('Parse_Customer_Response')['status']}"
              }
            }
          }
        }
      },
      "expression": {
        "equals": [
          "@body('Parse_Customer_Response')['status']",
          "active"
        ]
      },
      "type": "If"
    },
    "Return_Success_Response": {
      "runAfter": {
        "Check_Customer_Status": [
          "Succeeded"
        ]
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "body": {
          "message": "Process completed successfully",
          "customerId": "@triggerBody()['customerId']"
        }
      }
    }
  },
  "outputs": {}
}