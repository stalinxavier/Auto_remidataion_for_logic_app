{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_an_HTTP_request_is_received": {
      "type": "Request",
      "kind": "Http"
    }
  },
  "actions": {
    "Compose": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@if(equals(coalesce(triggerBody()?['value'], 0), 0), 0, div(10, triggerBody()?['value']))"
    }
  },
  "outputs": {}
}